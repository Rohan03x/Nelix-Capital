# Large/ephemeral cache files — excluded from bundle
# Keep webapp/data/cache/search_shard_*.json and search_exchanges.json in the
# bundle; they are the fast local ticker-search universe for deployed autocomplete.
# Individual company fundamentals (fetched live per-request)
webapp/data/cache/eodhd_fund_*.json
# Redundant flat index (shards below are the canonical source)
webapp/data/cache/search_index_prebuilt.json
# Per-query search result caches (ephemeral, fetched live)
webapp/data/cache/eodhd_ticker_search_*.json
# Exchange symbol snapshots (re-fetched live as needed)
webapp/data/cache/eodhd_exchange_symbols_*.json
# All other eodhd_ raw data caches
webapp/data/cache/eodhd_*.json
# Peer caches and index (ephemeral, re-fetched per request)
webapp/data/cache/*_peers.json
webapp/data/cache/_peer_index.pkl
# Learning DB and ledger (rebuilt from Supabase at runtime)
# Use file-type wildcards because Vercel ignores .gitignore when .vercelignore exists
auto_valuation/learning/db/
auto_valuation/learning/db/*
auto_valuation/learning/db/**
auto_valuation/learning/ledger/
auto_valuation/learning/ledger/*
auto_valuation/learning/ledger/*.jsonl
auto_valuation/learning/ledger/**
auto_valuation/learning/data/
auto_valuation/learning/data/*
auto_valuation/learning/data/**
!auto_valuation/learning/data/
!auto_valuation/learning/data/dashboard_learning_seed.json
# Large binary/data file types — never needed at runtime in Lambda
*.db
**/*.db
*.db-*
**/*.db-*
*.sqlite
**/*.sqlite
*.sqlite-*
**/*.sqlite-*
*.pkl
**/*.pkl
*.jsonl
**/*.jsonl
overrides/

