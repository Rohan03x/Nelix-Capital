{
  "buildCommand": "python build.py",
  "builds": [
    {
      "src": "api/ticker_search.py",
      "use": "@vercel/python"
    },
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api/ticker-search$",
      "dest": "/api/ticker_search.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/app.py"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/learning/cron",
      "schedule": "*/5 * * * *"
    }
  ]
}