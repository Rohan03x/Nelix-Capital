{
  "buildCommand": "python build.py",
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{webapp/data/cache/{eodhd_*.json,*_peers.json,_peer_index.pkl,search_index_prebuilt.json},auto_valuation/learning/{db,ledger}/**,tests/**,*.{xlsx,docx,png}}"
      }
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api/ticker-search$",
      "dest": "/app.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/app.py"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/learning/cron",
      "schedule": "0 0 * * *"
    }
  ]
}